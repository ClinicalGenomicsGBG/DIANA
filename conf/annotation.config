   conda activate tsneenv

   if ! command -v Rscript >/dev/null 2>&1; then
       echo "WARNING: Rscript not found — creating placeholder outputs"
       touch "${sample_id}_tsne_plot_pancan.pdf"
       touch "${sample_id}_tsne_plot_pancan.html"
