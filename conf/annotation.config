       conda env list
       echo "PATH: \$P
       exit 1
   fi

   echo "Using RscriptRscript)"

   # Run the memory-opript (uses 30k probes instead of 100k to reduce RAM usage)
   Rscript ${params.dissnn_tsne_fixed.R \\
       --color-map ${c
       --bed ${epic_be
       --trainingset $\
       --method umap \
