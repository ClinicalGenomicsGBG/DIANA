   # Flatten PDF with maximum printer compatibility (soft — skips if gs absent)
   if command -v gs >/hen
       echo "Ghostscriening PDF to PDF 1.4 for printer compatibility..."
       gs -q -dBATCH - \
          -sDEVICE=pdf
          -dCompatibil
          -dEmbedAllFo
