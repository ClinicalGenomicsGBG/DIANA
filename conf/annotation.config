   else
       echo "ERROR: Rs Available R-related files:"
       find /opt/condadev/null | head -10
       find /usr -namedev/null | head -10
       exit 1
   fi
   
   echo "Using RscriptATH"

   \$RSCRIPT_PATH -e "r('\${PWD}/${rmd_template}', output_file=commandArgs(trailingOnly=TRUE)[24])" \
     "${sample_id}" \
     "\${PWD}/${cramin
