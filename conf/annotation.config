         path(protein_
         path(rmd_temp
         path(warning_
         path(nanodx_c),
         path(dictiona
         path(tsne_plo
         path(gbm_prots)

   output:
   file("${sample_id}_e_report.pdf")

   script:
   """
   # Output PDF path
   output_file="${samppipeline_report.pdf"

   # Handle different 
   if [ "${params.run_true" ]; then
       # For run_mode_mple_file.txt with sample_id and threshold_value
       THRESHOLD_VALUE
       if [ -f "${pararoutine_annotation/${sample_id}/cnv/ace/${sample_id}_ace_results/threshold_value.txt" ]; then
           THRESHOLD_Varams.output_path}/routine_annotation/${sample_id}/cnv/ace/${sample_id}_ace_results/threshold_value.txt")
           # Create sa
           echo -e "${THRESHOLD_VALUE}" > sample_file.txt
           echo "Creatxt for run_mode_order with: ${sample_id} \${THRESHOLD_VALUE}"
           SAMPLE_FILE_file.txt"
       else
           echo "ERRORfile not found for ${sample_id} at ${params.output_path}/routine_annotation/${sample_id}/cnv/ace/${sample_id}_ace_results/threshold_value.txt"
           exit 1
       fi
   else
       # For run_mode_k if user provided tumor content first (takes priority)
       if [ ! -f "${sa; then
           echo "ERROR not found: ${sample_id_file}"
           exit 1
       fi

       # Count columnsd_file
       NUM_COLS=\$(awkt}' "${sample_id_file}")
       echo "Detected ns in sample_id_file: ${sample_id_file}"

       if [ "\$NUM_COL
           # User provsample_id + tumor content) - use user-provided value
           # Extract t sample_id
           grep "^${sa:]]" "${sample_id_file}" > sample_file.txt || {
               echo "W{sample_id} not found in ${sample_id_file}, creating file with sample_id only"
               echo "$ample_file.txt
