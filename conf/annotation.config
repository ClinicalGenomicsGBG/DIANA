  bcftools view -O z -niffles2_under30mb.vcf.gz   -i '(INFO/SVTYPE="DUP" || INFO/SVTYPE="INV" || INFO/SVTYPE="INS") && INFO/SVLEN < 30000000 || (INFO/SVTYPE="DEL" && INFO/SVLEN > -30000000)'   $wf_sv
  bcftools index -t ${les2_under30mb.vcf.gz


  java -jar ${params.svanna-cli-1.0.4.jar prioritize  \
  -d ${params.ref_dir}
  --vcf  $wf_sv \
  --phenotype-term HP:
  --output-format html
  --prefix ${sample_idotation

 # cp "${sample_id}_roion.html" "${params.output_path}/report/${sample_id}_svanna.html"

  """


/ Fusion event analysi_sv_v5.py (BEDTools-based SV classification)
rocess svannasv_fusion
