   tuple val(sample_ide_id}.sv_fusions.tsv")
   tuple val(sample_ide_id}.sv_fusions_any_any.tsv")
   tuple val(sample_ide_id}.sv_fusions_any_gbm.tsv"),     optional: true
   tuple val(sample_ide_id}.sv_fusions_both_gbm.tsv"),    emit: filterfusioneventout, optional: true
   tuple val(sample_ide_id}.sv_fusions_gbm_protein.tsv"), emit: gbmproteinfusionout, optional: true
   tuple val(sample_ide_id}.sv_gbm_genes.tsv"),           optional: true
   tuple val(sample_ide_id}.sv_breakpoints_gbm.tsv"),     optional: true

   script:
   """
   classify_sv_v5.py \
       --vcf ${roi_sva
       --sample-id ${s
       --min-fusion-si
       --gff3 ${geneco
       --gene-list ${r} \\
       --outdir .
   """



/ Circos plot generatil variant visualization
rocess circosplot {
  label 'circos'
  publishDir "${paramsutine_annotation/${sample_id}/structure_variant/svannasv/", mode: "copy", overwrite: true
  
  input:
  tuple val(sample_id)tput), path(vcf2circos_json)

  output:
  tuple val(sample_id)_id}_vcf2circo.html"), optional: true, emit: circosout

  script:
  """
  # Check if file is eheader)
  # Handle both gzippeed VCF files
  if [[ ${svanna_outpuhen
     # For gzipped fil
     VARIANT_COUNT=\$(tput} | grep -v '^#' | wc -l)
  else
     # For uncompressep directly
     VARIANT_COUNT=\$(vanna_output} | wc -l)
  fi

  if [ \$VARIANT_COUNT
     echo "Warning: ${as no variants (0 non-header lines). Skipping vcf2circos plot generation."
     touch ${sample_id
     exit 0
  else
     echo "Found \$VARnts in ${svanna_output}. Generating circos plot..."
     # Try to generatet create empty file if it fails
     set +e  # Don't e
     vcf2circos -i $sv{sample_id}_vcf2circo.html -p $vcf2circos_json -a hg38
     CIRCOS_EXIT=\$?
     set -e  # Re-enab

     if [ \$CIRCOS_EXI
         echo "Warningled with exit code \$CIRCOS_EXIT. Creating empty placeholder file."
         touch ${samplhtml
     else
         echo "Circos uccessfully."
     fi
  fi
  """


/ Copy number variant nalysis with ACE
rocess annotatecnv {
  label 'annotatecnv'
   publishDir "${paramoutine_annotation/${sample_id}/cnv/", mode: "copy", overwrite: true

  input:
   tuple val(sample_id
         path(vcf_file
         path(roi_prot
         path(calls_be
         path(seg_bed)
         val(thresholdcitly receiving threshold
         path(cnv_gene genes annotation file

  output:
  tuple val(sample_id)_id}_calls_fixed.vcf"), emit: callsfixedout
  tuple val(sample_id)_id}_annotatedcnv.csv"), emit:annotatedcnvcsvout
  tuple val(sample_id)_id}_annotatedcnv_filter.csv"), emit:annotatedcnvfiltercsvout
  tuple val(sample_id)_id}_annotatedcnv_filter_header.csv"), emit:rmdannotatedcnvfilter
  tuple val(sample_id)_id}_tumor_copy.txt"), path("${sample_id}_bins_filter.bed"), emit:tumorcopyandbinsfilterout
  tuple val(sample_id)_id}_cnv_plot_full.pdf"), path("${sample_id}_tumor_copy_number.txt"), path("${sample_id}_annotatedcnv_filter_header.csv"), path("${sample_id}_cnv_chr9.pdf"), path("${sample_id}_cnv_chr7.pdf"), emit: rmdcnvtumornumber
  // TIFF outputs fromhigh-resolution images)
  ///tuple val(sample_ple_id}_cnv_plot_full.tiff"), emit: cnvplotfulltiff
  ///tuple val(sample_ple_id}_cnv_chr9.tiff"), emit: cnvchr9tiff
  ///tuple val(sample_ple_id}_cnv_chr7.tiff"), emit: cnvchr7tiff

  script:
  """
   #!/bin/bash
   ##source /opt/condaonda.sh
   ##conda activate an

   # Check if we're in use appropriate conda setup
   if [ -f "/opt/condaonda.sh" ]; then
       # Container env
  source /opt/conda/eta.sh
  conda activate annot
   else
       # Local environ
       source activate
   fi

   # Debug output
   echo "Processing sad}"
   echo "Using thresho"
   
   # Process VCF file
   awk 'OFS="\\t" {if hr"\$1; print}' $vcf_file > ${sample_id}_calls_fixed.vcf
   
   # Intersect and pro
   intersectBed -a ${sfixed.vcf -b $roi_protein_coding_bed -wa -wb | \
       cut -f1,2,5,8,2n_coding/' | \
       awk -v OFS=";" 
       awk 'BEGIN { FS {\$1=\$1; print}' | \
  cut -f1,2,3,5,6,8,9,}_annotatedcnv.csv

   # Generate plots an
  #cnv_html.R $calls_bannotatedcnv.csv ${sample_id}_CNV_plot.pdf ${sample_id}_CNV_plot.html $sample_id

   CNV_function_new_upd $cnv_genes_tuned $seg_bed \
       ${sample_id}_cn${sample_id}_cnv_chr9.pdf ${sample_id}_cnv_chr7.pdf $sample_id

   # Process annotatio
   awk 'BEGIN { OFS=",]+>/, substr(\$3, 2, length(\$3) - 2), \$3); print \$0 }' \
       ${sample_id}_an ${sample_id}_annotatedcnv_filter.csv

   awk 'BEGIN {print ",End,SVLEN,Score,LOG2CNT,Gene"} 1' \
       ${sample_id}_anr.csv > ${sample_id}_annotatedcnv_filter_header.csv

   # Run CNV mapping w
   cnv_mapping_occfusig_bed $roi_protein_coding_bed \
       ${sample_id}_tuample_id}_bins_filter.bed ${threshold}
   
   cnv_mapping_occfusier.py $seg_bed \
       ${sample_id}_tutxt ${threshold}
   """


/ Annotation of Clair3 results
rocess clair3_annotate
   label 'clair3'
   publishDir "${paramoutine_annotation/${sample_id}/snv_annotation", mode: "copy", overwrite: true

   input:
   tuple val(sample_idutput_dir), path(pileup_vcf), path(merge_vcf)

   output:
   tuple val(sample_ide_id}_roi_pileup_snvs_avinput")
   tuple val(sample_ide_id}_roi_pileup_annotateandfilter.csv"), emit:roipileupannotateandfilterout
   tuple val(sample_ide_id}_roi_merge_snv_avinpt")
   tuple val(sample_ide_id}_roi_merge.hg38_multianno.txt")
   tuple val(sample_ide_id}_merge_annotateandfilter.csv"), emit:mergeannotateandfilterout
   tuple val(sample_ide_id}_roi_pileup_annotateandfilter.csv"), path("${sample_id}_merge_annotateandfilter.csv"), emit:clair3output

   script:
   """
   convert2annovar.pl 
       --format vcf4 \
       --withfreq \
       --filter pass \
       --fraction 0.1 
       --includeinfo \
       --outfile ${samup_snvs_avinput

   table_annovar.pl  $pileup_snvs_avinput \
       -outfile roi_pi
       -buildver hg38 e,clinvar_20240611,cosmic100coding2024\
       -operation g,f,
       ${params.humand
       -otherinfo

   awk '/exonic/ && /n !/Benign/ && !/Likely_benign/|| /upstream/ || /Func.refGene/ || /splicing/ && !/Benign/ && !/Likely_benign/ || /Pathogenic/' roi_pileup.hg38_multianno.txt \
       | awk '/exonic/unc.refGene/ || /Pathogenic/'  \
       | awk '!/dist=1
       | cut -f1-16,26e_id}_roi_pileup_annotateandfilter.csv

   convert2annovar.pl 
       --format vcf4 \
       --withfreq \
       --filter pass \
       --fraction 0.1 
       --includeinfo \
       --outfile ${same_snv_avinpt

   table_annovar.pl ${erge_snv_avinpt \
       -outfile roi_me
       -buildver hg38 e,clinvar_20240611,cosmic100coding2024\
       -operation g,f,
       ${params.humand
       -otherinfo

   awk '/exonic/ && /n !/Benign/ && !/Likely_benign/|| /upstream/ || /Func.refGene/ || /splicing/ && !/Benign/ && !/Likely_benign/ || /frameshift/ && !/Benign/ && !/Likely_benign/ || /stopgain/ && !/Benign/ && !/Likely_benign/ || /Pathogenic/' \
       roi_merge.hg38_
       | awk '/exonic/unc.refGene/ || /Pathogenic/'  \
       | awk '!/dist=1
       | cut -f1-16,26
       > ${sample_id}_dfilter.csv

   cp roi_merge.hg38_mample_id}_roi_merge.hg38_multianno.txt
   """




/ Somatic variant call-TO for tumor-only samples
/ Annotation of ClairSing results
rocess clairs_to_annot
   label 'clairsto'
   publishDir "${paramoutine_annotation/${sample_id}/snv_annotation", mode: "copy", overwrite: true

   input:
   tuple val(sample_ido_output'), path(snv_vcf), path(indel_vcf)

   output:
   //tuple val(sample_sto_output/')
   tuple val(sample_ide_id}_clairS_To_snv_avinput")
   tuple val(sample_ide_id}_ClairS_TO_snv.hg38_multianno.txt")
   tuple val(sample_ide_id}_annotateandfilter_clairsto.csv"), emit:annotateandfilter_clairstoout
   tuple val(sample_ide_id}_merge_snv_indel_claisto.vcf.gz"), emit: clairsto_merged_vcf

   script:
   """
   # VCF index files (eady exist from the epi2me:run_clairs_to process
   # bcftools concat rdex files to be present
   # The directory is sto_output' to access both VCF files and their .tbi index files
   bcftools concat -a output/snv.vcf.gz clairsto_output/indel.vcf.gz -Oz -o ${sample_id}_merge_snv_indel_claisto.vcf.gz

   convert2annovar.pl ge_snv_indel_claisto.vcf.gz \
       --format vcf4 \
       --filter pass \
       --includeinfo \
       --outfile  ${saTo_snv_avinput

   table_annovar.pl ${S_To_snv_avinput \
       -outfile ClairS
       -buildver hg38 e,clinvar_20240611,cosmic100coding2024\
       -operation g,f,
       ${params.humand
       -otherinfo

   awk '/exonic/ && /n !/Benign/ && !/Likely_benign/|| /upstream/ || /Func.refGene/ || /splicing/ && !/Benign/ && !/Likely_benign/ || /frameshift/ && !/Benign/ && !/Likely_benign/ || /stopgain/ && !/Benign/ && !/Likely_benign/ || /Pathogenic/' \
       ClairS_TO_snv.ht \
       | awk '/exonic/unc.refGene/ || /Pathogenic/'  \
       | awk '!/dist=1
       | cut -f1-16,25id}_annotateandfilter_clairsto.csv

   cp ClairS_TO_snv.hg ${sample_id}_ClairS_TO_snv.hg38_multianno.txt
   """


/ VEP-based SNV annotae to ANNOVAR — set snv_annotator = 'vep')
/ Requires: params.vepms.clinvar_vcf, params.cosmic_vcf
/ ─────────────────────────────────────────────────────────────

rocess clair3_annotate
   label 'vep'
   publishDir "${paramoutine_annotation/${sample_id}/snv_annotation", mode: "copy", overwrite: true

   input:
   tuple val(sample_idutput_dir), path(pileup_vcf), path(merge_vcf)

   output:
   tuple val(sample_ide_id}_roi_pileup_vep.vcf.gz")
   tuple val(sample_ide_id}_roi_pileup_annotateandfilter.csv"), emit: roipileupannotateandfilterout
   tuple val(sample_ide_id}_roi_merge_vep.vcf.gz")
   tuple val(sample_ide_id}_roi_merge.vep.vcf.gz")
   tuple val(sample_ide_id}_merge_annotateandfilter.csv"), emit: mergeannotateandfilterout
   tuple val(sample_ide_id}_roi_pileup_annotateandfilter.csv"), path("${sample_id}_merge_annotateandfilter.csv"), emit: clair3output

   script:
   def vep_args = """\
       --format vcf --
       --compress_outp
       --assembly GRCh
       --species homo_
       --cache --dir_cp_cache_dir} --cache_version ${params.vep_cache_version} \\
       --fasta ${paramme} \\
       --offline --no_ask.cpus} \\
       --force_overwri
       --symbol --biot--mane --pick \\
       --pick_order malus_clinical,canonical,appris,tsl,biotype,ccds,rank,length \\
       --hgvs --protei
       --sift b --poly
       --refseq \\
       --custom file=$vcf},short_name=ClinVar,format=vcf,type=exact,coords=0,fields=CLNSIG%CLNDN%CLNREVSTAT%CLNHGVS%CLNDISDB \\
       --custom file=$cf},short_name=COSMIC,format=vcf,type=exact,coords=0,fields=GENE%CNT%ID"""
   """
   export PATH=${param$PATH

   # ── Pileup VCF ──────────────────────────────────────────
   vep --input_file ${tput_file ${sample_id}_roi_pileup_vep.vcf.gz ${vep_args}

   filter_vep --format
       --input_file ${ileup_vep.vcf.gz \\
       --output_file $up_filt.vcf \\
       --filter "Consese_variant,inframe_insertion,inframe_deletion,upstream_gene_variant or ClinVar_CLNSIG match Pathogenic"

   vep_to_annovar_formd}_pileup_filt.vcf ${sample_id}_pileup_annovar.tsv clair3

   awk -F'\\t' 'BEGIN{ || (\$15 !~ /[Bb]enign/ || \$15 ~ /[Pp]athogenic/)' \\
       ${sample_id}_pi \\
   | awk -F'\\t' 'NR==c" || (\$7=="TERT" && (\$6!="upstream" || (\$8~/^dist=/ && int(substr(\$8,6))<=260)))' \\
   | awk -F'\\t' 'NR==t=166/' \\
   > ${sample_id}_roi_ndfilter.csv

   # ── Merge VCF ───────────────────────────────────────────
   vep --input_file ${put_file ${sample_id}_roi_merge_vep.vcf.gz ${vep_args}
   cp ${sample_id}_roiz ${sample_id}_roi_merge.vep.vcf.gz

   filter_vep --format
       --input_file ${erge_vep.vcf.gz \\
       --output_file $e_filt.vcf \\
       --filter "Consese_variant,inframe_insertion,inframe_deletion,upstream_gene_variant,frameshift_variant,stop_gained or ClinVar_CLNSIG match Pathogenic"

   vep_to_annovar_formd}_merge_filt.vcf ${sample_id}_merge_annovar.tsv clair3

   awk -F'\\t' 'BEGIN{ || (\$15 !~ /[Bb]enign/ || \$15 ~ /[Pp]athogenic/)' \\
       ${sample_id}_me\\
   | awk -F'\\t' 'NR==c" || (\$7=="TERT" && (\$6!="upstream" || (\$8~/^dist=/ && int(substr(\$8,6))<=260)))' \\
   | awk -F'\\t' 'NR==t=166/' \\
   > ${sample_id}_mergter.csv
   """


rocess merge_clairsto_
   publishDir "${paramoutine_annotation/${sample_id}/snv_annotation", mode: "copy", overwrite: true

   input:
   tuple val(sample_ido_output'), path(snv_vcf), path(indel_vcf)

   output:
   tuple val(sample_ide_id}_merge_snv_indel_claisto.vcf.gz"), emit: merged_vcf

   script:
   """
   bcftools concat -a 
       clairsto_outputrsto_output/indel.vcf.gz \\
       -Oz -o ${samplendel_claisto.vcf.gz
   """


rocess clairs_to_annot
   label 'vep'
   publishDir "${paramoutine_annotation/${sample_id}/snv_annotation", mode: "copy", overwrite: true

   input:
   tuple val(sample_idcf)

   output:
   tuple val(sample_ide_id}_clairsto_vep.vcf.gz")
   tuple val(sample_ide_id}_ClairS_TO_snv.vep.vcf.gz")
   tuple val(sample_ide_id}_annotateandfilter_clairsto.csv"), emit: annotateandfilter_clairstoout

   script:
   """
   export PATH=${param$PATH

   # Keep only PASS vaent with ANNOVAR's --filter pass behaviour
   # Uses awk + bgzip tainer via htslib) instead of bcftools
   tabix -p vcf ${merg
   zcat ${merged_vcf} 
     awk 'substr(\$1,1="PASS"' | \
     bgzip > ${sample_s.vcf.gz
   tabix -p vcf ${samppass.vcf.gz

   vep \\
       --input_file ${sto_pass.vcf.gz \\
       --output_file $rsto_vep.vcf.gz \\
       --format vcf --
       --compress_outp
       --assembly GRCh
       --species homo_
       --cache --dir_cp_cache_dir} --cache_version ${params.vep_cache_version} \\
       --fasta ${paramme} \\
       --offline --no_ask.cpus} \\
       --force_overwri
       --symbol --biot--mane --pick \\
       --pick_order malus_clinical,canonical,appris,tsl,biotype,ccds,rank,length \\
       --hgvs --protei
       --sift b --poly
       --refseq \\
       --custom file=$vcf},short_name=ClinVar,format=vcf,type=exact,coords=0,fields=CLNSIG%CLNDN%CLNREVSTAT%CLNHGVS%CLNDISDB \\
       --custom file=$cf},short_name=COSMIC,format=vcf,type=exact,coords=0,fields=GENE%CNT%ID

   cp ${sample_id}_cla ${sample_id}_ClairS_TO_snv.vep.vcf.gz

   filter_vep --format
       --input_file ${sto_vep.vcf.gz \\
       --output_file $rsto_filt.vcf \\
       --filter "Consese_variant,inframe_insertion,inframe_deletion,upstream_gene_variant,frameshift_variant,stop_gained or ClinVar_CLNSIG match Pathogenic"

   vep_to_annovar_formd}_clairsto_filt.vcf ${sample_id}_clairsto_annovar.tsv clairsto

   awk -F'\\t' 'BEGIN{ || (\$15 !~ /[Bb]enign/ || \$15 ~ /[Pp]athogenic/)' \\
       ${sample_id}_clsv \\
   | awk -F'\\t' 'NR==c" || (\$7=="TERT" && (\$6!="upstream" || (\$8~/^dist=/ && int(substr(\$8,6))<=260)))' \\
   | awk -F'\\t' 'NR==t=166/' \\
   > ${sample_id}_annoairsto.csv
   """


/ Merge and filter annair3 and ClairS-TO results
rocess merge_annotatio
   debug true
   label 'merge_annota
   publishDir "${paramoutine_annotation/${sample_id}/merge_annot_clair3andclairsto/", mode: "copy", overwrite: true

