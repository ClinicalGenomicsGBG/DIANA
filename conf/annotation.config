/ Neural network classmor type prediction using NanoDx CrossNN classifier
rocess crossNN {
   label 'nanodx'
   publishDir "${paramoutine_annotation/${sample_id}/classifier/nanodx", mode: "copy", overwrite: true
   
   input:
   tuple val(sample_id), path(model_file), path(snakefile), path(nn_model)
   
   output:
   tuple val(sample_ide_id}_nanodx_classifier.txt")
   tuple val(sample_ide_id}_nanodx_classifier.tsv"), emit: rmdnanodx
   
   script:
   """
   #!/bin/bash
   export TMPDIR="\${P
   export XDG_CACHE_HOache"
   mkdir -p "\$TMPDIR/
   
   # Use container's c
   source /opt/conda/eda.sh
   conda activate base
   conda activate nano

   # Remove symlinked id overwriting the reference file
   rm -f Snakefile

   # Create Snakefile hs and reduced memory
   cat << EOF > Snakef
ule all:
   input:
       "${sample_id}_n.txt",
       "${sample_id}_n.tsv"

ule NN_classifier:
   input:
       bed = "${bed_fi
       model = "${mode
   output:
       txt = "${samplesifier.txt",
       votes = "${sampassifier.tsv"
   threads: 2
   resources:
       mem_mb = 2048
   script: "${params.nir}/scripts/classify_NN_bedMethyl.py"
OF

   # Run snakemake wit
   if ! snakemake --co --verbose NN_classifier; then
       echo "Snakemakeg empty output files"
       touch "${samplesifier.txt"
       touch "${samplesifier.tsv"
       echo "NN classickle compatibility issue" > "${sample_id}_nanodx_classifier.txt"
   fi
   """


/ Dimensionality reduction using t-SNE/UMAP
