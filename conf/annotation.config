/ ACE tumor content capy number analysis
rocess ace_tmc {
   label 'ace_tmc'
   publishDir "${paramoutine_annotation/${sample_id}/cnv/ace/", mode: "copy", overwrite: true
   
   input:
   tuple val(sample_id)
   
   output:
       tuple val(samplample_id}_ace_results"), emit: aceresults
   tuple val(sample_id_value), emit: threshold_value
   
   script:
   """
   #!/bin/bash
   set -e

   # Check if we're in use appropriate conda setup
   if [ -f "/opt/condaonda.sh" ]; then
       source /opt/con/conda.sh
       conda activate 
   else
   source activate ace
   fi
   
   # Debug info
   echo "Processing sad}"
   echo "Input RDS fil
   ls -l ${rds_file}

   # Create output dir
   mkdir -p ${sample_i
   
   # Run ACE TMC analy
   ace_tmc.R "${rds_fid}_ace_results" "${sample_id}"
   
   # Read and export tue
   threshold_value=\$(}_ace_results/threshold_value.txt")
   echo "Threshold valid}: \$threshold_value"
