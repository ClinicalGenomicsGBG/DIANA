           THRESHOLD_Varams.output_path}/routine_annotation/${sample_id}/cnv/ace/${sample_id}_ace_results/threshold_value.txt")
           echo -e "${THRESHOLD_VALUE}" > sample_file.txt
           echo "Creatxt with ACE-calculated tumor content: ${sample_id} \${THRESHOLD_VALUE}"
           SAMPLE_FILE_file.txt"
       else
           # Only 1 coresults - copy as-is
           cp "${samplle_file.txt
           SAMPLE_FILE_file.txt"
           echo "Creatfile.txt (single column, no tumor content)"
           cat "\${SAM
       fi
   fi

   # Now call the Rscrated Rmd file using absolute paths
   # Activate conda ennd Rscript
   source /opt/conda/eda.sh
   conda activate mark
   
   # Try to find Rscri
   RSCRIPT_PATH=""
   if command -v Rscri&1; then
       RSCRIPT_PATH="R
   elif [ -f "/opt/con_env/bin/Rscript" ]; then
