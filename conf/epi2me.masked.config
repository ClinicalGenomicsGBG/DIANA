/*
 * Epi2me config variant for masked GRCh38 reference.
 * Loads the standard epi2me settings and overrides only the reference FASTA/FAI.
 */

includeConfig 'epi2me.config'

params {
    reference_genome = "/clinical/dev/cgg-cancer/nanopore/references/GRCh38/masked/GCA_000001405.15_GRCh38_no_alt_analysis_set_masked.fna"
    reference_genome_bai = "/clinical/dev/cgg-cancer/nanopore/references/GRCh38/masked/GCA_000001405.15_GRCh38_no_alt_analysis_set_masked.fna.fai"
}
